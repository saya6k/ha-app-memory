#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# MCP server (streamable HTTP at /mcp), consumed by HA Assist.
# ==============================================================================
set -euo pipefail

# shellcheck source=/dev/null
source /usr/lib/ha-memory/options.sh
# shellcheck source=/dev/null
source /usr/lib/ha-memory/embedding.sh

if [[ "$(embedding_provider)" == "local" ]]; then
    bashio::log.info "Waiting for the embedding sidecar to become ready …"
fi
if ! wait_for_sidecar; then
    bashio::log.fatal "Embedding sidecar did not become ready within 30 minutes."
    bashio::log.fatal "Check the llama-server logs above for a download or model-load failure."
    exit 1
fi
if [[ "$(embedding_provider)" == "local" ]]; then
    bashio::log.info "Embedding sidecar is ready."
else
    bashio::log.info "Using the $(embedding_provider) embedding service."
fi

export DB_PATH=/data/facts.sqlite
export MCP_PORT=8099
export MANUALS_DIR=/share/manuals
# Personal documents, one folder per Home Assistant user id.
export USERS_DIR=/data/users
# The panel answers only Supervisor's ingress proxy.
export UI_PORT=8100
export UI_ALLOWED_ADDRESS=172.30.32.2
export_embedding_env

# Create the folders up front so /share/manuals is there to copy files into
# (Samba, File editor) before anything has been uploaded.
mkdir -p "${MANUALS_DIR}" "${USERS_DIR}"

# log_level is optional; leave the variable unset so the app applies its own
# default rather than parsing an empty string.
log_level="$(option log_level)"
if [[ -n "${log_level}" ]]; then
    export LOG_LEVEL="${log_level}"
fi

bashio::log.info "Starting MCP server on 0.0.0.0:8099 (/mcp) and the panel on :8100"
cd /opt/mcp-server
exec node dist/index.js
